G_CLIENT_ID=
G_CLIENT_SECRET=
JWT_SECRET=
INIT_TABLE=true
ENABLE_CACHE=true
PRODUCTHUNT_API_TOKEN=
NEWS_CLASSIFIER_ENABLED=false
NEWS_CLASSIFIER_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
NEWS_CLASSIFIER_API_KEY=
NEWS_CLASSIFIER_MODEL=qwen3.6-flash-2026-04-16
NEWS_CLASSIFIER_TIMEOUT_MS=30000
NEWS_CLASSIFICATION_VERSION=industry-v1
MCP_INTERNAL_TOKEN=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# NewsNow AI - choose qwen (legacy) or jev (OpenRouter Decisions API)
NEWS_CLASSIFIER_PROVIDER=qwen
NEWS_JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
NEWS_JEV_MODEL=typesafe/jev-1.14
NEWS_JEV_API_KEY=
OPENROUTER_API_KEY=

# Agent answers from news stored by the Node backend
AGENT_CHAT_MODEL=openai/gpt-4o-mini
AGENT_OPENROUTER_API_KEY=
